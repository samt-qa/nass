{
  "name": "@samt-qa/nass",
  "version": "0.3.1",
  "description": "Arabic text normalization and diacritic-insensitive search for Quran, hadith and heritage texts, with match offsets in the original vocalized text.",
  "license": "MIT",
  "author": "Samt Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samt-qa/nass.git",
    "directory": "packages/js"
  },
  "homepage": "https://github.com/samt-qa/nass#readme",
  "bugs": "https://github.com/samt-qa/nass/issues",
  "keywords": [
    "arabic",
    "quran",
    "hadith",
    "normalization",
    "search",
    "highlight",
    "tashkeel",
    "diacritics",
    "unicode"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./isnad": {
      "import": {
        "types": "./dist/isnad.d.ts",
        "default": "./dist/isnad.js"
      },
      "require": {
        "types": "./dist/isnad.d.cts",
        "default": "./dist/isnad.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include=src --coverage.thresholds.lines=95 --coverage.thresholds.branches=90",
    "size": "node scripts/size.mjs",
    "bench": "node scripts/bench.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run size"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
